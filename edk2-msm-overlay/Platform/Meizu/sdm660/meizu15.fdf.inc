// per-device BSP DXEs for the Meizu 15 (M8810, SDM660)

// ACPI Tables
// The SDM660 tables in Silicon/Qualcomm/sdm660/AcpiTables are SoC-level and are
// reused verbatim; nothing here is device-specific yet. When the port reaches the
// point of a working ACPI OS, replace DSDT.aml with a Meizu15-derived one.
FILE FREEFORM = 7E374E25-8E01-4FEE-87F2-390C23C606CD {
  SECTION RAW = Silicon/Qualcomm/sdm660/AcpiTables/DSDT/DSDT.aml
  SECTION RAW = Silicon/Qualcomm/sdm660/AcpiTables/BuiltIn/CSRT.aml
  SECTION RAW = Silicon/Qualcomm/sdm660/AcpiTables/BuiltIn/DBG2.aml
  SECTION RAW = Silicon/Qualcomm/sdm660/AcpiTables/BuiltIn/FACS.aml
  SECTION RAW = Silicon/Qualcomm/sdm660/AcpiTables/BuiltIn/FADT.aml
  SECTION RAW = Silicon/Qualcomm/sdm660/AcpiTables/BuiltIn/GTDT.aml
  SECTION RAW = Silicon/Qualcomm/sdm660/AcpiTables/BuiltIn/MADT.aml
  SECTION RAW = Silicon/Qualcomm/sdm660/AcpiTables/BuiltIn/MCFG.aml
  SECTION UI = "AcpiTables"
}

// Mainline device tree blob
// Intentionally empty: the bootloader hands us the live FDT in x0/cmdline and
// UniXNU's DarwinBoot reads it from there. Add a FILE FREEFORM entry here only
// if a device-specific DTB has to be baked into the volume.

// ---------------------------------------------------------------------------
// UniXNU payload volume
//
// The FAT image that scripts/build-esp.sh produces (kernel.macho + its ADT +
// unixnu.toml) travels inside the firmware volume, as a FREEFORM file with a
// *compressed* RAW section:
//
//   - compressed, because an FFS file header carries its size in 24 bits, i.e. a
//     single file cannot exceed 16 MiB, and the payload volume is larger than that
//     uncompressed;
//   - FREEFORM, because Meizu15PayloadDxe walks the FVs looking for exactly this
//     GUID, then asks FirmwareVolume2 for the decompressed EFI_SECTION_RAW bytes
//     and registers them as a ramdisk. FatDxe mounts it and SimpleInit sees
//     /EFI/UniXNU/unixnu.toml.
//
// A build without a payload present is still valid: the FILE is simply absent and
// the driver logs "the payload volume is not in any FV" and exits.
// ---------------------------------------------------------------------------
// The image is generated by scripts/build-esp.sh in the same CI run, into this
// exact path, before edk2 is invoked. No build macro is involved: an FDF
// "!ifdef" would need the flag threaded through build.sh, and a missing file
// should be a loud build failure rather than a silently payload-less firmware.
FILE FREEFORM = 3f1a9c22-5b41-4a0e-9c77-2d618b4fe01a {
  SECTION COMPRESS PI_STD {
    SECTION RAW = Platform/Meizu/sdm660/payload/unixnu-esp.img
  }
}
