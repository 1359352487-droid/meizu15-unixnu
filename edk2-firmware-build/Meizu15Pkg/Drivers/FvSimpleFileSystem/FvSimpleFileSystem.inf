## @file
#  FvSimpleFileSystem - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = FvSimpleFileSystem
  FILE_GUID                      = 907125c0-a5f1-11e3-a3fe-a3198b49350c
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|FvSimpleFileSystem.efi|DEBUG
