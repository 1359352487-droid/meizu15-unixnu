## @file
#  ASN1X509Dxe - prebuilt UEFI module carved from the Meizu 15 (M1881, SDM660) XBL.
#
#  Origin: xbl_a (mmcblk0p1) -> ELF LOAD #11 @0x7e380 -> FFS2 volume
#          -> gzip FV_IMAGE @0x0a70d0 -> this module.
#  The FILE_GUID below is the GUID this module was published under in the stock
#  volume; it is not invented.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ASN1X509Dxe
  FILE_GUID                      = c2f9a4f5-f7b4-43e7-ba99-5ea804cc103a
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|ASN1X509Dxe.efi|DEBUG
