## @file
#  ASN1X509Dxe - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ASN1X509Dxe
  FILE_GUID                      = c2f9a4f5-f7b4-43e7-ba99-5ea804cc103a
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|ASN1X509Dxe.efi|DEBUG
