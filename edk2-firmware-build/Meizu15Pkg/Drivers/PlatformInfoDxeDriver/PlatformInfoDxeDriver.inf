## @file
#  PlatformInfoDxeDriver - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PlatformInfoDxeDriver
  FILE_GUID                      = b105211b-bbbd-4add-a3b0-d1cf4a52154c
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|PlatformInfoDxeDriver.efi|DEBUG
