## @file
#  UsbDeviceDxe - prebuilt UEFI module carved from the Meizu 15 (M1881, SDM660) XBL.
#
#  Origin: xbl_a (mmcblk0p1) -> ELF LOAD #11 @0x7e380 -> FFS2 volume
#          -> gzip FV_IMAGE @0x0a70d0 -> this module.
#  The FILE_GUID below is the GUID this module was published under in the stock
#  volume; it is not invented.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UsbDeviceDxe
  FILE_GUID                      = 3299a266-15f0-4346-8318-716336736d3e
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|UsbDeviceDxe.efi|DEBUG
