## @file
#  RealTimeClock - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = RealTimeClock
  FILE_GUID                      = b336f62d-4135-4a55-ae4e-4971bbf0885d
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|RealTimeClock.efi|DEBUG
