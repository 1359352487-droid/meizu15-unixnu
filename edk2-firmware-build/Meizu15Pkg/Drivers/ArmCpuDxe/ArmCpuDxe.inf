## @file
#  ArmCpuDxe - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ArmCpuDxe
  FILE_GUID                      = b8d9777e-d72a-451f-9bdb-bafb52a68415
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|ArmCpuDxe.efi|DEBUG
