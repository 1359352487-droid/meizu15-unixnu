## @file
#  SimpleTextInOutSerial - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SimpleTextInOutSerial
  FILE_GUID                      = 857a8741-0eec-43bd-9482-27d14ed47d72
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|SimpleTextInOutSerial.efi|DEBUG
