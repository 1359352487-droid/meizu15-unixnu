## @file
#  EmbeddedMonotonicCounter - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = EmbeddedMonotonicCounter
  FILE_GUID                      = 37795ba0-e1cf-4ed5-bd8b-16df6bcb1e1a
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|EmbeddedMonotonicCounter.efi|DEBUG
