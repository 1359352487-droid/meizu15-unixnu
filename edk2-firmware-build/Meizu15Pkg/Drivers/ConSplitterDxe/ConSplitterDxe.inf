## @file
#  ConSplitterDxe - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ConSplitterDxe
  FILE_GUID                      = 408edcec-cf6d-477c-a5a8-b4844e3de281
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|ConSplitterDxe.efi|DEBUG
