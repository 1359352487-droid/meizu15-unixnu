## @file
#  DxeCore - prebuilt UEFI module carved from the Meizu 15 (M1881, SDM660) XBL.
#
#  Origin: xbl_a (mmcblk0p1) -> ELF LOAD #11 @0x7e380 -> FFS2 volume
#          -> gzip FV_IMAGE @0x0a70d0 -> this module.
#  The FILE_GUID below is the GUID this module was published under in the stock
#  volume; it is not invented.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = DxeCore
  FILE_GUID                      = d6a2cb7f-6a18-4e2f-b43b-9920a733700a
  MODULE_TYPE                    = DXE_CORE
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|DxeCore.efi|DEBUG
