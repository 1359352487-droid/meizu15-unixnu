## @file
#  DxeCore - prebuilt UEFI module carved from the phone's own XBL.
#
#  Origin: xbl_a -> ELF PT_LOAD -> FFS2 volume -> gzip FV_IMAGE -> this module.
#  FILE_GUID is the GUID this module was published under in the stock volume.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = DxeCore
  FILE_GUID                      = d6a2cb7f-6a18-4e2f-b43b-9920a733700a
  MODULE_TYPE                    = DXE_CORE
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|DxeCore.efi|DEBUG
