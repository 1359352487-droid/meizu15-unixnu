## @file
#  ULogDxe - prebuilt UEFI module carved from the Meizu 15 (M1881, SDM660) XBL.
#
#  Origin: xbl_a (mmcblk0p1) -> ELF LOAD #11 @0x7e380 -> FFS2 volume
#          -> gzip FV_IMAGE @0x0a70d0 -> this module.
#  The FILE_GUID below is the GUID this module was published under in the stock
#  volume; it is not invented.
#
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ULogDxe
  FILE_GUID                      = e43128a8-8692-42b6-8afa-676158578d18
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

[Binaries]
  PE32|ULogDxe.efi|DEBUG
