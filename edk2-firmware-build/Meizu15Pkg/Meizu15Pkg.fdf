## @file
#  Meizu15Pkg firmware volume description.
#
#  Size is 5 MiB: the 67 extracted modules total 3.73 MiB of PE32, plus FFS and
#  section headers. The stock volume was 1.75 MiB only because its inner
#  FV_IMAGE was gzip-compressed; we ship it uncompressed into the boot image,
#  which has 64 MiB of room.
#
[Defines]
  DEFINE BLOCK_SIZE        = 0x00010000

[FD.MEIZU15_UEFI]
BaseAddress   = 0x8000
Size          = 0x00500000
ErasePolarity = 1
BlockSize     = $(BLOCK_SIZE)
NumBlocks     = 0x50

0x00000000|0x00500000
FV = MEIZU15_FV

[FV.MEIZU15_FV]
FvNameGuid         = 7152edf4-ac2b-51d3-8f22-c48618d74e9a
BlockSize          = $(BLOCK_SIZE)
NumBlocks          = 0x50
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

INF Meizu15Pkg/Drivers/DxeCore/DxeCore.inf
INF Meizu15Pkg/Drivers/ArmCpuDxe/ArmCpuDxe.inf
INF Meizu15Pkg/Drivers/RuntimeDxe/RuntimeDxe.inf
INF Meizu15Pkg/Drivers/SecurityDxe/SecurityDxe.inf
INF Meizu15Pkg/Drivers/SecRSADxe/SecRSADxe.inf
INF Meizu15Pkg/Drivers/ASN1X509Dxe/ASN1X509Dxe.inf
