## @file
#  Meizu15Pkg firmware volume description.
#
#  Size is 5 MiB. The stock inner volume was only 1.75 MiB because its
#  nested FV_IMAGE was gzip-compressed; here the modules ship uncompressed into
#  a boot partition that has 64 MiB of room.
#
[Defines]
  DEFINE BLOCK_SIZE        = 0x00010000

[FD.MEIZU15PKG_UEFI]
BaseAddress   = 0x8000
Size          = 0x00500000
ErasePolarity = 1
BlockSize     = $(BLOCK_SIZE)
NumBlocks     = 0x50

0x00000000|0x00500000
FV = MEIZU15PKG_FV

[FV.MEIZU15PKG_FV]
FvNameGuid         = 11b7514c-1460-551f-94fe-526a7106eda8
BlockSize          = $(BLOCK_SIZE)
NumBlocks          = 0x50
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

FILE DXE_DRIVER = c2f9a4f5-f7b4-43e7-ba99-5ea804cc103a {
  SECTION PE32 = Meizu15Pkg/Drivers/ASN1X509Dxe/ASN1X509Dxe.efi
}

